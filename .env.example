# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local ni claves reales al repositorio.

# --- Públicas (llegan al navegador) ---------------------------------------
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://inzyvqffesgjhvdrgdgg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Secretas (solo servidor, scripts y CI) --------------------------------
# Se usa en el script de importación del seed. Jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Enlace secreto en formato iCal del Google Calendar «Familia» (solo servidor, D-074).
# Google Calendar > Configuración del calendario > «Dirección secreta en formato iCal».
# Quien tenga este enlace puede leer TODO el calendario: ponlo solo como variable en Railway.
GOOGLE_CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/xxxx/private-xxxx/basic.ics

# --- IA (solo servidor, D-098/D-100) ----------------------------------------
# Clave de la API de Google Gemini (Google AI Studio). Solo como variable en Railway; jamás en el
# repositorio. Usa una clave con FACTURACIÓN activada: en el nivel gratuito Google puede usar lo
# que se envía para mejorar sus productos.
GEMINI_API_KEY=xxxxxxxxxxxxxxxx
# Opcional: modelo (por defecto gemini-flash-latest, el Flash más reciente).
# IA_MODELO=gemini-flash-latest   (alias del Flash vigente; hoy apunta a gemini-3.8-flash)
# IA_MODELO_RESPALDO=gemini-flash-lite-latest   (si el principal da 503; «ninguno» lo desactiva)

# --- Avisos por correo (D-114) ---
# Resumen de la mañana por correo con Resend. Todo esto va en las variables de Railway.
# RESEND_API_KEY=re_...
# Correo que recibe el resumen. Con el remitente de pruebas de Resend (el de por defecto) solo vale
# el correo de la cuenta de Resend; para escribir a otras personas hay que verificar un dominio.
# Uno o varios, separados por comas (tú y Ana):
# AVISOS_CORREO=tu@correo.com,ana@correo.com
# Remitente (opcional): AVISOS_DE=Menús Semanales <avisos@tudominio.com>
# Secreto largo (≥24 caracteres) que debe llevar quien pida el envío. El mismo valor va en el
# secreto AVISOS_CRON_SECRET de GitHub (Settings → Secrets and variables → Actions).
# AVISOS_CRON_SECRET=
# Token del enlace del calendario (el trozo de 64 letras y números del enlace .ics de Más → Enviar).
# AVISOS_CALENDARIO_TOKEN=
# Hora de Madrid a la que se envía (opcional, por defecto 10).
# AVISOS_HORA=10

# --- Notificaciones push (D-115) ---
# Las claves se generan desde la app: Más → Enviar → Notificaciones en el móvil → «Generar las claves».
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contacto del servicio (opcional; por defecto mailto:AVISOS_CORREO):
# VAPID_SUBJECT=mailto:tu@correo.com
